<form id="{{ action }}-total-form" class="total-form" action="{{ oViewConf.getSelfLink()|raw }}" method="post">
    {{ oViewConf.getHiddenSid()|raw }}
    <input type="hidden" name="cl" value="payeverordertab">
    <input type="hidden" name="fnc" value="processAction">
    <input type="hidden" name="oxid" value="{{ oxid }}">
    <input type="hidden" name="type" value="total">
    <input type="hidden" name="action" value="{{ action }}">
    <input type="hidden" name="editval[oxorder__oxid]" value="{{ oxid }}">
    {% if formError[action] is defined %}
        <div class="edittext red" style="color:red;">
            {{ formError[action] }}
        </div>
    {% endif %}
    <div>
        <input type="submit" name="{{ action }}-submit-btn" class="edittext total-form-submit-btn" style="padding: 3px;" value="{{ ("PAYEVER_ORDER_PROCESS_" ~ actionLang)|translate }}">
    </div>
</form>